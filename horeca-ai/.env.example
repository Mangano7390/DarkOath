# ─── Database ───────────────────────────────
DATABASE_URL="postgresql://horeca:horeca@localhost:5432/horeca?schema=public"

# ─── NextAuth ───────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-in-prod-use-openssl-rand-base64-32"

# ─── Anthropic ──────────────────────────────
ANTHROPIC_API_KEY=""
# Available: claude-opus-4-7, claude-sonnet-4-6, claude-haiku-4-5
ANTHROPIC_MODEL="claude-sonnet-4-5"
ANTHROPIC_MAX_TOKENS="4096"

# ─── SMTP (devis sortants, inbox réponses) ──
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="HoReCa AI <no-reply@horeca.local>"

# ─── App ────────────────────────────────────
COMPANY_NAME="HoReCa Distribution"
COMPANY_ADDRESS="Rue de l'exemple 1, 1000 Bruxelles"
COMPANY_VAT="BE0123456789"
COMPANY_EMAIL="contact@horeca.local"
COMPANY_PHONE="+32 2 000 00 00"
DEFAULT_LOCALE="fr"

# ─── Rate limiting (in-memory token bucket par défaut) ──
AI_RATE_LIMIT_PER_MIN="30"
